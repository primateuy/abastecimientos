<odoo>
    <record id="view_users_form_inherit_almacenes" model="ir.ui.view">
        <field name="name">res.users.form.inherit.almacenes</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">

            <!-- Insertamos una nueva pestaña al final del notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Almacenes">
                    <group>
                        <field name="warehouse_ids" widget="many2many_tags"/>
                        <button name="action_add_all_warehouses"
                                string="Agregar todos los almacenes"
                                type="object"
                                class="btn btn-link"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>
</odoo>