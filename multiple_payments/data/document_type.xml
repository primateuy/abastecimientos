<odoo>
    <data>
        <!-- Precargar tipos de documentos -->
        <record id="incoming_receipt" model="l10n_latam.document.type">
            <field name="name">Incoming Manual Receipt</field>
            <field name="code">0</field>
            <field name="doc_code_prefix">IMR</field>
            <field name="internal_type">invoice</field>
            <field name="country_id"  ref="base.uy" />
        </record>
        <record id="outgoing_receipt" model="l10n_latam.document.type">
            <field name="name">Outgoing Manual Receipt</field>
            <field name="code">0</field>
            <field name="doc_code_prefix">OMR</field>
            <field name="internal_type">invoice</field>
            <field name="country_id"  ref="base.uy" />
        </record>
    </data>
</odoo>