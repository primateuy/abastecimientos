<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="seq_aggregator" model="ir.sequence">
            <field name="name">Secuencia Aggregator</field>
            <field name="code">aggregator.sequence</field>
            <field name="prefix">AGP/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Secuencia para números de coincidencia parcial -->
        <record id="seq_partial_matching" model="ir.sequence">
            <field name="name">Secuencia Partial Matching</field>
            <field name="code">partial.matching.sequence</field>
            <field name="prefix">PM</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
