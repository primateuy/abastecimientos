<odoo>
    <data>
        <!-- Precargar dos talonarios de clientes -->
        <!-- Talonario de recibos salientes -->
        <record id="customer_receipt_books_outbound" model="mps.receipt.books">
            <field name="name">Talonario de recibo saliente - Cliente</field>
            <field name="partner_type">customer</field>
            <field name="type">outbound</field>
            <field name="is_public">False</field>
        </record>
        <!-- Talonario de recibos entrantes -->
        <record id="customer_receipt_books_inbound" model="mps.receipt.books">
            <field name="name">Talonario de recibo entrante - Cliente</field>
            <field name="partner_type">customer</field>
            <field name="type">inbound</field>
            <field name="is_public">False</field>
        </record>

        <!-- Precargar dos talonarios de proveedores -->
        <!-- Talonario de recibos salientes -->
        <record id="supplier_receipt_books_outbound" model="mps.receipt.books">
            <field name="name">Talonario de recibo saliente - Proveedor</field>
            <field name="partner_type">supplier</field>
            <field name="type">outbound</field>
            <field name="is_public">False</field>
        </record>
        <!-- Talonario de recibos entrantes -->
        <record id="supplier_receipt_books_inbound" model="mps.receipt.books">
            <field name="name">Talonario de recibo entrante - Proveedor</field>
            <field name="partner_type">supplier</field>
            <field name="type">inbound</field>
            <field name="is_public">False</field>
        </record>
    </data>
</odoo>