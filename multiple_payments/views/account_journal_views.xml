<odoo>
    <!-- form -->
    <record id="account_journal_view_inherit_form" model="ir.ui.view">
        <field name="name">account_journal_view_inherit_form</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="intermediate_diary"/>
            </xpath>
        </field>
    </record>
</odoo>