<odoo>
    <data>
        <!-- Form -->
        <record id="account_journal_aggregator_view_form" model="ir.ui.view">
            <field name="name">account.journal.aggregator.view.form</field>
            <field name="model">account.journal.aggregator</field>
            <field name="arch" type="xml">
                <form string="">
                    <sheet>
                        <group>
                            <field name="account_journal_id"/>
                            <field name="company_id" options="{'no_create': True}"/>
                            <field name="currency_id" options="{'no_create': True}"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree -->
        <record id="account_journal_aggregator_view_tree" model="ir.ui.view">
            <field name="name">account.journal.aggregator.view.tree</field>
            <field name="model">account.journal.aggregator</field>
            <field name="arch" type="xml">
                <tree string="">
                    <field name="account_journal_id"/>
                    <field name="company_id"/>
                    <field name="currency_id"/>
                </tree>
            </field>
        </record>

        <!-- Action -->
        <record id="account_journal_aggregator_view_action" model="ir.actions.act_window">
            <field name="name">Intermediate diary</field>
            <field name="res_model">account.journal.aggregator</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>