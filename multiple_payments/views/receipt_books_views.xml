<odoo>
    <!-- form -->
    <record id="mps_receipt_books_views_form" model="ir.ui.view">
        <field name="name">mps.receipt.books.views.form</field>
        <field name="model">mps.receipt.books</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <h1 class="oe_title">
                        <field name="name" placeholder="Talonario de Recibo de ejemplo"/>
                    </h1>
                    <group>
                        <group>
                            <field name="partner_type"/>
                            <field name="type" widget="radio" options="{'horizontal': true}"/>
                             <field name="journal_ids_domain" invisible="1"/>
                            <field name="account_journal_id" string="Diario de Pago a Cuenta" domain="journal_ids_domain"/>
                            <field name="enable_reverse_payment" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="document_type_id" options="{'no_create': True}"/>
                            <field name="reference"/>
                            <field name="is_public" widget="boolean_toggle" readonly="1" groups="base.group_system"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- tree -->
    <record id="mps_receipt_books_views_tree" model="ir.ui.view">
        <field name="name">mps.receipt.books.views.tree</field>
        <field name="model">mps.receipt.books</field>
        <field name="arch" type="xml">
            <tree string="">
                <field name="name"/>
                <field name="partner_type"/>
                <field name="type"/>
            </tree>
        </field>
    </record>

    <!-- action -->
    <record id="mps_receipt_books_views_action" model="ir.actions.act_window">
        <field name="name">Receiptbooks</field>
        <field name="res_model">mps.receipt.books</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Action para el proveedor -->
    <record id="mps_receipt_books_supplier_views_action" model="ir.actions.act_window">
        <field name="name">Supplier's Receiptbooks</field>
        <field name="res_model">mps.receipt.books</field>
        <field name="domain">[('partner_type','=','supplier'),('is_public','=',True)]</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{
            'default_partner_type':'supplier'
        }</field>
    </record>

    <!-- Action para el cliente -->
    <record id="mps_receipt_books_customer_views_action" model="ir.actions.act_window">
        <field name="name">Customer's Receiptbooks</field>
        <field name="res_model">mps.receipt.books</field>
        <field name="domain">[('partner_type','=','customer'),('is_public','=',True)]</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{
            'default_partner_type':'customer'
        }</field>
    </record>
</odoo>