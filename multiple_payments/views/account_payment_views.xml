<odoo>
    <data>
        <record id="account_payment_inherit_mps_form" model="ir.ui.view">
            <field name="name">account.payment.form</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form" />
            <field name="arch" type="xml">
                <xpath expr="//group[@name='main_group']//label[@for='is_internal_transfer']" position="after">
                     <!-- <group name="main_group">
                            <group name="group1">
                                <label for="is_internal_transfer"/> -->
                    <field name="payment_aggregator_id"/>
                    <field name="is_internal_transfer_mps" invisible="not payment_aggregator_id"/>
                </xpath>

                <xpath expr="//group[@name='main_group']//field[@name='partner_id']" position="after">
                    <field name="partner_mps_id" context="{'default_is_company': True}" string="Customer" options="{'no_quick_create': True}" invisible="partner_type != 'customer' or not payment_aggregator_id" readonly="state != 'draft'"/>
                    <field name="partner_mps_id" context="{'default_is_company': True}" string="Vendor" options="{'no_quick_create': True}" invisible="partner_type != 'supplier' or not payment_aggregator_id" readonly="state != 'draft'"/>
                </xpath>

                <xpath expr="//field[@name='payment_type']" position="after">
                    <field name="payment_type_mps" widget="radio" options="{'horizontal': True}" readonly="state != 'draft'" invisible="not payment_aggregator_id"/>
                </xpath>

                <xpath expr="//field[@name='date']" position="after">
                    <field name="date_mps" readonly="state != 'draft'"/>
                </xpath>

                <xpath expr="//field[@name='l10n_latam_check_id']" position="after">
                    <field name="l10n_latam_check_mps_id" readonly="state != 'draft'"/>
                </xpath>
<!-- 
                <xpath expr="//group[@name='main_group']//field[@name='partner_id'][@invisible='partner_type != 'supplier' or is_internal_transfer']" position="attributes">
                    <attribute name="invisible">partner_type != 'customer' or is_internal_transfer and not payment_aggregator_id or payment_aggregator_id</attribute>
                </xpath>

                <xpath expr="//group[@name='main_group']//field[@name='partner_id'][@invisible='partner_type != 'supplier' or is_internal_transfer']" position="attributes">
                    <attribute name="invisible">partner_type != 'customer' or is_internal_transfer and not payment_aggregator_id or payment_aggregator_id</attribute>
                </xpath> -->
            </field>
        </record>

        <!-- Tree para los pagos agrupados -->
        <record id="account_payment_multiple_payments_group_view_tree" model="ir.ui.view">
            <field name="name">account.payment.multiple.payments.group.tree</field>
            <field name="model">account.payment</field>
            <field name="arch" type="xml">
                <tree edit="false" sample="1" decoration-info="state == 'draft'" decoration-muted="state == 'cancel'">
                    <header>
                        <button name="action_post" type="object" string="Confirm"/>
                    </header>
                    <field name="company_currency_id" column_invisible="True"/>
                    <field name="suitable_journal_ids" column_invisible="True"/>
                    <field name="available_payment_method_line_ids" column_invisible="True"/>
                    <field name="date_mps" readonly="state in ['cancel', 'posted']"/>
                    <field name="name"/>
                    <field name="journal_id"/>
                    <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                    <field name="payment_method_line_id"/>
                    <field name="partner_mps_id" string="Customer"/>
                    <field name="amount_signed" string="Amount in Currency" optional="hide" groups="!base.group_multi_currency"/>
                    <field name="amount_signed" string="Amount in Currency" optional="show" groups="base.group_multi_currency"/>
                    <field name="currency_id" string="Payment Currency" optional="hide"/>
                    <field name="activity_ids" widget="list_activity" optional="hide"/>
                    <field name="amount_company_currency_signed" widget="monetary" string="Amount" sum="Total"/>
                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'posted'"/>
                </tree>
            </field>
        </record>
    </data>
</odoo>