<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_stock_lot_form_inherit_lot_cost" model="ir.ui.view">
        <field name="name">stock.lot.form.inherit.lot.cost</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="inside">
                <group string="Valorización por Lote">
                    <field name="lot_unit_cost"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
