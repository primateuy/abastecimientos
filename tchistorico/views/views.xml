<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- Hereda la vista tree de stock.valuation.layer para agregar el campo nuevoCampo -->
    <record id="tchistorico_stock_valuation_layer_tree_inherit" model="ir.ui.view">
      <field name="name">stock.valuation.layer.tree.inherit.tchistorico</field>
      <field name="model">stock.valuation.layer</field>
      <field name="inherit_id" ref="stock_account.stock_valuation_layer_tree"/>
      <field name="arch" type="xml">
        
        
        <xpath expr="//field[@name='quantity']" position="after">
          <field string="* Valor total MR" options="{'currency_field': 'moneda_reporte_id'}" name="valorMonedaSecundaria" optional="show" />
          <field string="* Valor restante MR" options="{'currency_field': 'moneda_reporte_id'}" name="valorRestante" optional="show" />
          <field string="* Valor unitario MR" options="{'currency_field': 'moneda_reporte_id'}" name="valorUnitario" optional="show" />
          <field
          string="* Moneda secundaria" name="moneda_reporte_id" optional="hide" />
          <field name="cotizacionDia" optional="hide" string="* Tipo de Cambio"  widget="float"/>
          <field name="ucmr" 
                 widget="float" 
                 options="{'currency_field': 'moneda_reporte_id'}"
                 string="* UCMR"
                 optional="hide"
                 />
          
          <field name="inverse_company_rate" optional="hide" string="* Cotización del día"/>
          <field name="company_rate" optional="hide" string="* Cotización del día inversa"/>
          <field invisible="quantity == 0" name="unitCostesDestinoInc" widget="monetary" optional="hide" options="{'currency_field': 'currency_id'}" string="* Costo total unitario"/>
          <field invisible="quantity == 0" name="unitCostesDestinoIncMR" widget="monetary" optional="hide" options="{'currency_field': 'moneda_reporte_id'}" string="* Costo total unitario MR"/>
          <field invisible="quantity == 0" name="valorizadoCosteDestino" widget="monetary" optional="hide" options="{'currency_field': 'currency_id'}" string="* Costo total"/>
          <field invisible="quantity == 0" name="valorizadoCosteDestinoMR" widget="monetary" optional="hide" options="{'currency_field': 'moneda_reporte_id'}" string="* Costo total MR"/>
          
        </xpath>
      </field>
    </record>

    <record id="tchistorico_res_company_form_inherit" model="ir.ui.view">
      <field name="name">res.company.form.inherit.tchistorico</field>
      <field name="model">res.company</field>
      <field name="inherit_id" ref="base.view_company_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='currency_id']" position="after">
          <field name="monedaDeReporte" string="Moneda de Reporte"/>
        </xpath>
      </field>
    </record>


    <record id="view_product_product_form_inherit" model="ir.ui.view">
        <field name="name">product.product.form.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='standard_price']" position="after">
                <div class="o_row">
                    <label for="ultimo_costo_mr" string="Costo Histórico en MR:"/>
                    <field name="ultimo_costo_mr" readonly="not id"/>
                    <span class="fa fa-info-circle ml-2" 
                          title="Este valor refleja el último costo en moneda de reporte, calculado al tipo de cambio del día de la transacción"/>
                </div>
            </xpath>
        </field>
    </record>

     <record id="product_product_tree_view_ucmr" model="ir.ui.view">
        <field name="name">product.product.tree.ucmr</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='standard_price']" position="after">
                <field name="ultimo_costo_mr" 
                       widget="monetary" 
                       options="{'currency_field': 'moneda_reporte_id'}"
                       string="UC MR"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_form_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='standard_price']" position="after">
                <div class="o_row">
                    <label for="ultimo_costo_mr" string="Costo Histórico en MR:"/>
                    <field name="ultimo_costo_mr" readonly="not id"/>
                </div>
            </xpath>
        </field>
    </record>

  <record id="view_move_form_inherit" model="ir.ui.view">
    <field name="name">account.move.form.inherit</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='line_ids']/tree" position="inside">
            <field name="valor_moneda_reportes" optional="hide" />
            <field name="cotizacion_historica" optional="hide" />
            <field name="moneda_reportes_id" optional="hide"/>
        </xpath>
    </field>
</record>

<record id="view_move_tree_inherit" model="ir.ui.view">
    <field name="name">account.move.tree.inherit</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_tree"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='company_id']" position="after">
            <field name="valor_moneda_reportes" 
                   widget="monetary" 
                   options="{'currency_field': 'moneda_reportes_id'}"
                   string="Valor MR"
                   optional="hide"/>
            <field name="cotizacion_historica" 
                   string="Cotización"
                   optional="hide"/>
            <field name="moneda_reportes_id" 
                   string="Moneda Reporte"
                   optional="hide"/>
        </xpath>
    </field>
</record>

<record id="view_product_stock_tree_inherit" model="ir.ui.view">
    <field name="name">product.product.stock.tree.ucmr</field>
    <field name="model">product.product</field>
    <field name="inherit_id" ref="stock.product_product_stock_tree"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='qty_available']" position="after">
            <field name="ultimo_costo_mr" 
                   widget="monetary" 
                   options="{'currency_field': 'moneda_reporte_id'}"
                   string="UC MR"
                   groups="base.group_user"/>
        </xpath>
    </field>
</record>

    

  </data>
</odoo>

