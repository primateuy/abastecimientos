<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Regla SOLO para CREATE: permite crear sin filtrar por compañía -->
    <record id="rule_mps_payment_aggregator_allow_create" model="ir.rule">
        <field name="name">Payment aggregator allow create</field>
        <field name="model_id" ref="multiple_payments.model_mps_payment_aggregator"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="perm_read" eval="0"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_unlink" eval="0"/>
        <field name="perm_create" eval="1"/>
        <field name="groups" eval="[(4, ref('account.group_account_user'))]"/>
    </record>

    <!-- Regla de compañía para R/W/U (no afecta create) -->
    <record id="rule_mps_payment_aggregator_company_rw" model="ir.rule">
        <field name="name">Payment aggregator by company (safe)</field>
        <field name="model_id" ref="multiple_payments.model_mps_payment_aggregator"/>
        <field name="domain_force">[('company_id','in', user.company_ids.ids)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_unlink" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="groups" eval="[(4, ref('account.group_account_user'))]"/>
    </record>
</odoo>
