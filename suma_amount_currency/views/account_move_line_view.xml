<odoo>
  <record id="view_move_line_tree_inherit_ml_safe_sum" model="ir.ui.view">
    <field name="name">account.move.line.tree.amount_currency.safe.sum</field>
    <field name="model">account.move.line</field>
    <field name="inherit_id" ref="account.view_move_line_tree"/>
    <field name="priority" eval="99"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='amount_currency']" position="attributes">
        <attribute name="sum">Total en divisa</attribute>
      </xpath>
    </field>
  </record>


</odoo>
