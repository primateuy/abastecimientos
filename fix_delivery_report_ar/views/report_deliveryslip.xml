<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Desactiva el override roto de l10n_ar_stock ($0 pattern) -->
    <record id="l10n_ar_stock.report_deliveryslip" model="ir.ui.view">
        <field name="active">False</field>
    </record>

    <!-- Desactiva el override de contenido AR para usar siempre el reporte nativo -->
    <record id="l10n_ar_stock.report_delivery_document" model="ir.ui.view">
        <field name="active">False</field>
    </record>

    <!-- Todas las empresas usan el template nativo con ubicaciones -->
    <template id="report_deliveryslip_fix" inherit_id="stock.report_deliveryslip" priority="50">
        <t t-foreach="docs" position="replace">
            <t t-foreach="docs" t-as="o">
                <t t-call="fix_delivery_report_ar.report_delivery_document_native" t-lang="o._get_report_lang()"/>
            </t>
        </t>
    </template>

</odoo>
