<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form_inherit_rounding_cash" model="ir.ui.view">
            <field name="name">account.move.form.inherit.view.rounding</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_outstanding_credits_debits_widget']/.." position="after">
                    <group name="note_group" col="6" class="mt-2 mt-md-0" invisible="move_type not in ['out_invoice', 'out_refund']">
                        <group class="oe_subtotal_footer oe_right" colspan="6" name="custom_round_off_total" invisible="move_type not in ['out_invoice', 'out_refund']">
                            <field name="custom_is_round_off_value" readonly="state ==  'posted'"/>
                            <button name="%(sale_order_invoice_rounding.action_so_inv_rounding_wiz)d" class="btn-sm btn-primary" string="Apply Round Off" type="action" invisible="(custom_is_round_off_value == False) or (state == 'posted')" groups="account.group_account_invoice"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
