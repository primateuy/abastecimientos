<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_order_form_inherit_rounding_cash" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.view.rounding</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='note_group']" position="after">
                    <group name="note_group" col="6" class="mt-2 mt-md-0">
                        <group class="oe_subtotal_footer oe_right" colspan="6" name="custom_round_off_total">
                            <field name="custom_is_round_off_value" readonly ="state in ['sale', 'done', 'cancel']"/>
                            <button name="%(sale_order_invoice_rounding.action_so_inv_rounding_wiz)d" class="btn-sm btn-primary" string="Apply Round Off" type="action" invisible="(custom_is_round_off_value  == False) or (state in  ['sale', 'done'])" groups="sales_team.group_sale_salesman"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
